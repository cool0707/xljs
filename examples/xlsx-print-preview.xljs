// Excel ブックを印刷プレビューで確認してから、プリンターで印刷するか PDF に出力する。
// exe にドロップした（または引数で渡した）ブック、なければ選んだブックが対象。
// プレビューでは用紙・向き・拡大縮小・余白・白黒と印刷するシートを変えられ、印刷ならプリンター・両面・部数も選べる。
// ページはブックの印刷の設定（印刷範囲・印刷タイトル・改ページ・ヘッダー/フッター・グラフ）に従う。
let target: FileSystemFileHandle | null = xljs.args.length ? fs.file(xljs.args[0]) : null;
if (!target) {
  [target] = await showOpenFilePicker({
    title: "印刷・PDF にするブックを選択（サンプル: data/売上レポート.xlsx）",
    types: [{ description: "Excel", accept: [".xlsx", ".xlsm"] }],
  });
}

const book = workbooks.open(target);
const pages = book.printPages() ?? [];
if (pages.length === 0) {
  alert(`${target.name} には印刷するものがありません。`);
  xljs.exit(1);
}

// 出力のしかたを選ぶ（前回の選択を覚える）
const printers = xljs.printers();
const choice = await ui.form({
  title: "印刷・PDF 出力",
  icon: "print",
  description: `${target.name}（${pages.map((p) => `${p.sheet}: ${p.pages} ページ`).join("、")}）`,
  fields: [
    {
      name: "output", label: "出力", type: "segmented", default: printers.length ? "印刷" : "PDF",
      options: printers.length ? ["印刷", "PDF"] : ["PDF"],
      help: printers.length ? `既定のプリンター: ${printers[0].name}` : "プリンターがないので PDF のみ",
    },
  ],
  submit: "プレビュー",
  submitIcon: "eye",
  remember: true,
});
if (!choice) xljs.exit(0);

if (choice.output === "印刷") {
  // プレビューで確定すると、ダイアログを出さずにそのまま印刷する。キャンセルなら false
  const printed = await book.print({ preview: { title: `印刷プレビュー - ${target.name}` } });
  if (printed) alert("印刷しました。");
} else {
  // 先にプレビューで設定を決めてから保存先を尋ねる（プレビューをキャンセルしたら保存先は聞かない）
  const options = await book.printPreview({}, {
    title: `印刷プレビュー - ${target.name}`,
    ok: "PDF に出力",
    settings: ["sheets", "paper", "landscape", "scaling", "margin", "blackAndWhite", "skipBlankPages"],
  });
  if (options) {
    const dest = await showSaveFilePicker({
      title: "PDF の保存先",
      startIn: path.dirname(target),
      suggestedName: path.basename(target.name, path.extname(target.name)) + ".pdf",
    });
    if (dest) {
      const created = await book.toPdf(dest, options);
      console.log("作成:", created);
      shell.showItemInFolder(created);
    }
  }
}
book.close();
